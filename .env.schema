# @plugin(@varlock/bitwarden-plugin)
# @initBitwarden(accessToken=fallback($BITWARDEN_ACCESS_TOKEN, ""))
# @generateTsTypes(path=src/env.d.ts)
# @import(./.env.keychain, enabled=and(eq($VARLOCK_OS, darwin), not($ROOMFORM_LOCAL)))
# ---

# Builtin platform detection is needed only while selecting config sources.
# @sensitive=false @internal
VARLOCK_OS=

# Credential-free development is enabled only by the dev:local command.
# @sensitive=false @dynamic @type=boolean
ROOMFORM_LOCAL=false

# Runtime mode is fixed by Vite for production bundles.
# @sensitive=false @type=enum(development, test, production)
NODE_ENV=development

# Supplied by the platform, or the conditionally imported macOS Keychain source.
# @sensitive @internal @required=not($ROOMFORM_LOCAL) @type=bitwardenAccessToken
BITWARDEN_ACCESS_TOKEN=

# @sensitive @required=not($ROOMFORM_LOCAL)
OPENAI_API_KEY=if($ROOMFORM_LOCAL, undefined, bitwarden("ec7c602f-c7aa-4ac6-993e-b4f20187ded0"))
# @sensitive @required=not($ROOMFORM_LOCAL)
SESSION_SECRET=if($ROOMFORM_LOCAL, undefined, bitwarden("2ff3d5d8-d2d7-4a2b-aa68-b4f20187df0d"))
# @sensitive @required=not($ROOMFORM_LOCAL)
AUTH_CLIENT_SECRET=if($ROOMFORM_LOCAL, undefined, bitwarden("093d9a98-db0a-44ae-bd0c-b4f2018a7055"))
# @sensitive=false @dynamic @required=not($ROOMFORM_LOCAL)
AUTH_CLIENT_ID=if($ROOMFORM_LOCAL, undefined, "roomform_dd49377094d4bb7659702cb9")
# @sensitive=false @dynamic
AUTH_ISSUER=https://auth.aranlucas.workers.dev/api/auth
# @sensitive=false @dynamic @type=url
APP_URL=if($ROOMFORM_LOCAL, "http://localhost:3000", "https://roomform-production.up.railway.app")
# @sensitive=false @dynamic
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# @sensitive=false @dynamic
OPENAI_VISION_MODEL=gpt-6.1-sol
# @sensitive=false @dynamic @type=boolean
DEV_AUTH_BYPASS=$ROOMFORM_LOCAL

# @sensitive=false @dynamic
DATA_DIR=.data

# @sensitive=false @dynamic
COLMAP_BIN=colmap

# Platform marker; used to keep development authentication bypass off on Vercel.
# @sensitive=false @dynamic @optional
VERCEL=
